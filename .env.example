# ==============================================================================
# GeoTrack — Configuration d'Environnement (Template)
# Copiez ce fichier sous le nom '.env' pour surcharger les valeurs locales
# ==============================================================================

# Environnement de l'application ('local' pour dev, 'production' pour déploiement)
APP_ENV=local
APP_URL=http://localhost:5173
API_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# Base de Données Relationnelle (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=geotrack
DB_USER=geotrack
DB_PASSWORD=geotrack

# Alias supportés pour les plateformes cloud (Render / Railway / Heroku)
DB_DATABASE=geotrack
DB_USERNAME=geotrack

# ------------------------------------------------------------------------------
# Moteur de Recherche (Elasticsearch 8.x)
# ------------------------------------------------------------------------------
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# Authentification Elasticsearch (Optionnel si cloud sécurisé / Elastic Cloud / Bonsai)
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# ------------------------------------------------------------------------------
# Sécurité & CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# En production, spécifiez l'URL exacte de votre frontend déployé (sans slash terminal)
# Exemple: https://geotrack.vercel.app,http://localhost:5173
# En local: '*' autorise toutes les origines de développement
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# Frontend Vite / React
# ------------------------------------------------------------------------------
# Utilisé par le frontend pour joindre l'API (doit pointer vers l'URL publique de l'API)
VITE_API_URL=http://localhost:8080/api
